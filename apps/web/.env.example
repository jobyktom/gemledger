# Public values (safe in the browser). Copy to .env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=https://rikpwgvbnrbyaolfduug.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XI4VhprNlSsjkjHlZc-R0g_3ETdM7n4

# Pre-launch: the login page fills in the test shop's mobile number (99999 00001).
# Set this to "off" before going live, then rebuild.
# NEXT_PUBLIC_LOGIN_PREFILL_PHONE=off

# Wallet passes (server-only secrets: set in Hostinger, never commit). Each wallet's
# "Add to … Wallet" button appears once its settings are present. See docs/LAUNCH_CHECKLIST.md.
# APPLE_WALLET_CERT_P12=        base64 of the Pass Type ID certificate exported as .p12
# APPLE_WALLET_CERT_PASSWORD=   the password chosen when exporting the .p12
# APPLE_WALLET_WWDR_CERT=       base64 of Apple's AppleWWDRCAG4.cer
# GOOGLE_WALLET_ISSUER_ID=      the number shown in the Google Pay & Wallet Console
# GOOGLE_WALLET_SERVICE_ACCOUNT= the service account's JSON key file (as JSON, or base64 of it)
